# LLM (OpenAI-compatible). If empty, Router/Reviewer use rules-only.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# true = Router/Reviewer never call LLM (offline / learning)
RULES_ONLY=false

# Web search (one provider). If empty, Search uses mock fixtures.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# RunStore SQLite path (used when Postgres URL empty/down).
RUN_STORE_PATH=data/runs.db

# --- Observability (all optional) ---
# LangSmith: empty key => tracing off (no-op). Non-empty enables LangChain/LangGraph traces.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agent-platform-poc

# OTel: default off (quiet server). Set true to print console spans while learning.
OTEL_ENABLED=false
OTEL_EXPORTER=console
# simple = immediate console (learning). batch = less sync overhead.
OTEL_SPAN_PROCESSOR=simple

# JSONL run log (under data/, gitignored)
JSONL_LOG_PATH=data/runs.jsonl

# Feedback JSONL path (used when Postgres URL empty/down).
FEEDBACK_LOG_PATH=data/feedback.jsonl

# Dev/test only: force reviewer ok=False for all tenants (default false).
# Prefer tenant force_reviewer_insufficient for smoke (see demo_loop.yaml).
FORCE_REVIEWER_INSUFFICIENT=false

# Token/cost lite: fill meta.usage with char/4 estimate when engine has no LLM usage
USAGE_ESTIMATE_ENABLED=true

# LangGraph HITL checkpoints (used when VECTOR_DATABASE_URL empty/down)
CHECKPOINT_SQLITE_PATH=data/checkpoints.db

# Shared Postgres: pgvector docs + T2SQL sales + RunStore + Feedback + HITL checkpoints
# Empty URL / PG down => keyword RAG + SQLite hybrid.db + SQLite RUN_STORE_PATH
# + JSONL feedback + SQLite CHECKPOINT_SQLITE_PATH
# Start DB: docker compose up -d  (host port 55432)
VECTOR_DATABASE_URL=postgresql://poc:poc@127.0.0.1:55432/agent_poc
EMBEDDING_MODEL=text-embedding-3-small
